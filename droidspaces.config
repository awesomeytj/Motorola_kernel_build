# Kernel config fragment for full Droidspaces support
# Target: sm8250 "nio" (kernel 4.19, non-GKI)
# Source: https://github.com/MGHazz/Droidspaces/blob/main/Documentation/Kernel-Configuration.md
#
# Merged into nio_defconfig at build time via:
#   make ... nio_defconfig droidspaces.config
# The kernel build system runs merge_config + olddefconfig automatically.
# Symbols that don't exist on 4.19 (renamed/merged in later kernels) are
# harmlessly dropped by olddefconfig; they are kept here for portability.

# IPC mechanisms (shared memory / IPC namespaces)
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support (isolation + init systems) - REQUIRED
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# Seccomp (syscall filtering / security shield)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups (systemd + resource accounting) - REQUIRED
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# Device filesystem (/dev setup, --hw-access) - REQUIRED
CONFIG_DEVTMPFS=y

# Overlay filesystem (volatile mode)
CONFIG_OVERLAY_FS=y

# Firmware loading (optional, --hw-access)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# --- Network isolation (NAT / none modes) ---
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Connection tracking
CONFIG_NF_CONNTRACK=y
# (kernels <= 4.18 only; merged into NF_CONNTRACK on 4.19, dropped by olddefconfig)
CONFIG_NF_CONNTRACK_IPV4=y

# iptables infrastructure
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y

# NAT
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
# (kernels <= 5.0; still valid on 4.19)
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# MASQUERADE (IP_NF_ name on <=5.1, XT_ name on 5.2+)
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# MSS clamping
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# addrtype match (--dst-type LOCAL DNAT port forwarding)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Conntrack netlink + NAT redirect (stateful NAT)
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y

# Policy routing
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Required for container internet to work on Android kernels
# CONFIG_ANDROID_PARANOID_NETWORK is not set
